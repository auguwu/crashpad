module(
    name = "crashpad",
    version = "0.8.0",
    bazel_compatibility = [">=7.2.1"],  # for `overlay/` directory
)

bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_features", version = "1.55.0")
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")
bazel_dep(name = "mini_chromium", version = "0.0.0-c029983")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "boringssl", version = "0.20261105.0")
bazel_dep(name = "package_metadata", version = "0.0.15")

lss = use_extension("//third_party/lss:extension.bzl", "lss")
use_repo(lss, "lss")

macos_sdk = use_repo_rule("//build/mig:sdk.bzl", "mig_macos_sdk")

macos_sdk(name = "mig_macos_sdk")
