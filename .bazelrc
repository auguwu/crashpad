common --registry=https://raw.githubusercontent.com/Noelware/bazel-registry/master/
common --registry=https://bcr.bazel.build

# Matches mini_chromium's `mac_deployment_target`; applies to compile and link.
common --macos_minimum_os=12.0

# on NixOS, $TZDIR is not in a valid location that the snapshot test needs. So, we'll re-route
# $TZDIR to whatever is set.
test --test_env=TZDIR
